[Desktop Entry]
Name=cat(a)log
Comment=The catalog for people who foster cats
Exec=catlog %f
Icon=catlog
Terminal=false
Type=Application
Categories=Utility;
MimeType=application/x-catsync;
# The running window carries this app id (set in the desktop binary), and
# KDE/Wayland matches it to this entry for the taskbar icon.
StartupWMClass=io.github.paxel.catlog
